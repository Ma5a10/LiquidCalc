{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "liquid-calc",
  "version": "0.1.0",
  "identifier": "com.ma5a10.app.liquid-calc",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Liquid Calc",
        "width": 350,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}